# Never commit installers or unpacked builds
*.tar.gz
*.AppImage
*.deb
*.exe
*.dmg
*.zip

# Versioned binary staging trees (thin manifests may live under latest/)
linux/v1.0.2/*
windows/v*/
windows/**/minibook3-*-win64-*

# Unpacked PyInstaller / install trees
**/minibook3-*-linux/
**/MiniBook3/
**/_internal/

# Local scratch
linux/**/linux/
*.log
.DS_Store
# Local Release upload tray (binaries)
staging/

docs/feasibility.md
